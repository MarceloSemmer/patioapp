# ---------------------------------------------------------------------------
# PátioGestor — variáveis de ambiente
# Copie este arquivo para ".env" e preencha os valores para o seu ambiente.
# ---------------------------------------------------------------------------

# Banco de dados PostgreSQL (local, Docker ou Supabase — connection string do Postgres)
# Em Supabase: Project Settings → Database → Connection string → "URI" (modo "Session pooling"
# para uso geral, ou a porta direta 5432 para rodar migrations).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/patiogestor?schema=public"

# NextAuth (Auth.js) — geração de sessão/JWT
# Gere um valor aleatório forte para produção, por exemplo com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-longo-e-secreto"
NEXTAUTH_URL="http://localhost:3000"

# URL pública da aplicação (usada para montar links absolutos, ex.: convites e recuperação de senha)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Envio de e-mail (opcional nesta versão)
# Sem estas variáveis, o sistema NÃO tenta enviar e-mails: os links de
# convite de usuário e redefinição de senha são exibidos diretamente na tela
# (apenas para uso local/demonstração). Configure um dos provedores abaixo
# para habilitar o envio real em produção — a integração de envio ainda
# precisa ser implementada no provedor escolhido (ver README, seção
# "Limitações conhecidas").
# ---------------------------------------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="PátioGestor <nao-responda@seudominio.com.br>"
# RESEND_API_KEY=

# ---------------------------------------------------------------------------
# Supabase (opcional — necessário apenas se migrar Storage/Auth para Supabase)
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
